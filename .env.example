# ------------------------------------------------------------------
# Supabase — client-side (safe to expose to the browser)
# In a Vite app, only vars prefixed with VITE_ are exposed to client code.
# Find these in: Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# The "anon"/"publishable" public key (safe for the browser; RLS protects data)
VITE_SUPABASE_ANON_KEY=

# Optional: some Lovable/Supabase setups also reference these
VITE_SUPABASE_PROJECT_ID=

# ------------------------------------------------------------------
# Supabase — server-side ONLY (NEVER expose to the browser / no VITE_ prefix)
# Only add this if you use it in server functions (src/server.ts, server routes).
# The service_role key bypasses Row Level Security — keep it secret.
# ------------------------------------------------------------------

# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Anthropic (Claude) — server-side ONLY (no VITE_ prefix, keep secret)
# Powers business-card scanning (/capture) and "Enrich from website".
# Create a key at https://platform.claude.com → API Keys
# ------------------------------------------------------------------

# ANTHROPIC_API_KEY=
